# ===== Backend =====
BACKEND_PORT=8080

# ===== MySQL =====
MYSQL_PORT=3307
MYSQL_ROOT_PASSWORD=your_root_password
MYSQL_DATABASE=bus_ticket_booking
MYSQL_USER=your_db_user
MYSQL_PASSWORD=your_db_password

# ===== Redis =====
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# ===== RabbitMQ =====
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=your_rabbitmq_user
RABBITMQ_PASSWORD=your_rabbitmq_password

# ===== phpMyAdmin =====
PHPMYADMIN_PORT=8081

# ===== VNPAY Sandbox =====
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://10.0.2.2:8088/api/payments/vnpay-return
VNPAY_TMN_CODE=your_vnpay_tmn_code
VNPAY_HASH_SECRET=your_vnpay_hash_secret
# Optional alias used by some VNPay samples/libraries:
VNPAY_HASH_SECRET_KEY=
VNPAY_EXPIRE_MINUTES=10

# ===== Dev health checks =====
MANAGEMENT_HEALTH_MAIL_ENABLED=false
MANAGEMENT_HEALTH_RABBIT_ENABLED=false

# ===== Firebase =====
FIREBASE_CONFIG_FILE=firebase-service-account.json

# ===== Mail =====
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
